u0440\u0430\u0437\u0435\u043e\u043b\u043e\u0433\u0438\u0437\u043c\u044b \u0438 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0435 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f ===\n* \n\n<!-- \u0421\u043b\u0443\u0436\u0435\u0431\u043d\u043e\u0435: -->\n{{improve|en|\u043f\u0440\u0438\u043c\u0435\u0440|\u0441\u0438\u043d\u043e\u043d\u0438\u043c\u044b|\u0433\u0438\u043f\u0435\u0440\u043e\u043d\u0438\u043c\u044b|\u044d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u044f}}\n{{\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f|\u044f\u0437\u044b\u043a=en|||}}\n{{\u0434\u043b\u0438\u043d\u0430 \u0441\u043b\u043e\u0432\u0430|4|en}}\n\n= {{-msk-}} =\n\n=== \u041c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u0441\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 ===\n{{\u0441\u0443\u0449 msk\n|\u043e\u0441\u043d\u043e\u0432\u0430=\n|\u0441\u043b\u043e\u0433\u0438={{\u043f\u043e-\u0441\u043b\u043e\u0433\u0430\u043c|book}}\n}}\n\n{{\u043c\u043e\u0440\u0444\u043e|\u043f\u0440\u0438\u0441\u04421=|\u043a\u043e\u0440\u0435\u043d\u044c1=|\u0441\u0443\u0444\u04441=|\u043e\u043a\u043e\u043d\u0447=|\u0447\u0430\u0441\u0442\u0438\u0446\u0430=}}\n\n=== \u041f\u0440\u043e\u0438\u0437\u043d\u043e\u0448\u0435\u043d\u0438\u0435 ===\n{{transcription||}}\n\n=== \u0421\u0435\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 ===\n\n==== \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 ====\n# [[\u043a\u0443\u0441\u043e\u043a]] {{\u043f\u0440\u0438\u043c\u0435\u0440||\u043f\u0435\u0440\u0435\u0432\u043e\u0434=}}\n# \n\n==== \u0421\u0438\u043d\u043e\u043d\u0438\u043c\u044b ====\n# ?\n# \n\n==== \u0410\u043d\u0442\u043e\u043d\u0438\u043c\u044b ====\n# \n# \n\n==== \u0413\u0438\u043f\u0435\u0440\u043e\u043d\u0438\u043c\u044b ====\n# ?\n# \n\n==== \u0413\u0438\u043f\u043e\u043d\u0438\u043c\u044b ====\n# \n# \n\n=== \u0420\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u043b\u043e\u0432\u0430 ===\n{{\u0440\u043e\u0434\u0441\u0442\u0432-\u0431\u043b\u043e\u043a\n|\u0443\u043c\u043b\u0430\u0441\u043a=\n|\u0443\u043d\u0438\u0447\u0438\u0436=\n|\u0443\u0432\u0435\u043b\u0438\u0447=\n|\u0438\u043c\u0435\u043d\u0430-\u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435=\n|\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435=\n|\u043f\u0440\u0438\u043b\u0430\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435=\n|\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435=\n|\u043c\u0435\u0441\u0442\u043e\u0438\u043c\u0435\u043d\u0438\u044f=\n|\u0433\u043b\u0430\u0433\u043e\u043b\u044b=\n|\u043d\u0430\u0440\u0435\u0447\u0438\u044f=\n|\u043f\u0440\u0435\u0434\u0438\u043a\u0430\u0442\u0438\u0432\u044b=\n|\u043f\u0440\u0435\u0434\u043b\u043e\u0433\u0438=\n|\u043f\u043e\u043b\u043d=\n}}\n\n=== \u042d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u044f ===\n\u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043e\u0442 {{\u044d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u044f:|}}\n\n=== \u0424\u0440\u0430\u0437\u0435\u043e\u043b\u043e\u0433\u0438\u0437\u043c\u044b \u0438 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0435 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f ===\n* \n\n=== \u0411\u0438\u0431\u043b\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f ===\n* \n\n{{improve|msk|\u043c\u043e\u0440\u0444\u043e|\u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u044f/\u043c\u043d|\u043f\u0440\u0438\u043c\u0435\u0440|\u0441\u0435\u043c\u0430\u043d\u0442\u0438\u043a\u0430|\u044d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u044f}}\n{{\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f|\u044f\u0437\u044b\u043a=msk|||}}\n{{\u0434\u043b\u0438\u043d\u0430 \u0441\u043b\u043e\u0432\u0430|4|msk}}\n= {{-enm-}} =\n\n=== \u041c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u0441\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 ===\n{{\u0441\u0443\u0449 enm |\u0441\u043b\u043e\u0433\u0438={{\u043f\u043e-\u0441\u043b\u043e\u0433\u0430\u043c|book}}|\u043e\u0441\u043d\u043e\u0432\u0430=|\u043e\u0441\u043d\u043e\u0432\u04301=}}\n\n{{\u0441\u043b\u043e\u0431\u0440|enm||||\u0443\u0441\u0435\u0447=|\u0447\u0435\u0440\u0435\u0434=|\u0438\u043d\u0442\u0435\u0440=|\u0438=}}\n\n{{\u043c\u043e\u0440\u0444\u043e|\u043f\u0440\u0438\u0441\u04421=|\u043a\u043e\u0440\u0435\u043d\u044c1=|\u0441\u0443\u0444\u04441=|\u043e\u043a\u043e\u043d\u0447=}}\n\n=== \u041f\u0440\u043e\u0438\u0437\u043d\u043e\u0448\u0435\u043d\u0438\u0435 ===\n{{transcriptions|||}}\n\n=== \u0421\u0435\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 ===\n{{\u0438\u043b\u043b|size=|lang=enm|}}\n\n==== \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 ====\n# {{#if:{{\u043f\u043e\u043c\u0435\u0442\u0430|}}|{{\u043f\u043e\u043c\u0435\u0442\u0430.|enm}}}} \u0432\u0430\u0440\u0438\u0430\u043d\u0442 [[bok]] {{\u043f\u0440\u0438\u043c\u0435\u0440|And of deed men, that thei risen ayen, han ye not red in the {{\u0432\u044b\u0434\u0435\u043b|book}} of Moises, on the buysch, hou God spak to hym, and seide, Y am God of Abraham, and God of Isaac, and God of Jacob?|John Wycliffe|New Testament|1380s|\u0447=Mark 12:26|||\u043f\u0435\u0440\u0435\u0432\u043e\u0434=\u0410 \u043e \u043c\u0435\u0440\u0442\u0432\u044b\u0445, \u0447\u0442\u043e \u043e\u043d\u0438 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u043d\u0443\u0442, \u0440\u0430\u0437\u0432\u0435 \u043d\u0435 \u0447\u0438\u0442\u0430\u043b\u0438 \u0432\u044b \u0432 {{\u0432\u044b\u0434\u0435\u043b|\u043a\u043d\u0438\u0433\u0435}} \u041c\u043e\u0438\u0441\u0435\u044f, \u043a\u0430\u043a \u0411\u043e\u0433 \u043f\u0440\u0438 \u043a\u0443\u043f\u0438\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b \u0435\u043c\u0443: \u042f \u0411\u043e\u0433 \u0410\u0432\u0440\u0430\u0430\u043c\u0430, \u0438 \u0411\u043e\u0433 \u0418\u0441\u0430\u0430\u043a\u0430, \u0438 \u0411\u043e\u0433 \u0418\u0430\u043a\u043e\u0432\u0430?}}\n# \n\n==== \u0421\u0438\u043d\u043e\u043d\u0438\u043c\u044b ====\n# \n# \n\n==== \u0410\u043d\u0442\u043e\u043d\u0438\u043c\u044b ====\n# \n# \n\n==== \u0413\u0438\u043f\u0435\u0440\u043e\u043d\u0438\u043c\u044b ====\n# \n# \n\n==== \u0413\u0438\u043f\u043e\u043d\u0438\u043c\u044b ====\n# \n# \n\n=== \u0420\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u043b\u043e\u0432\u0430 ===\n{{\u0440\u043e\u0434\u0441\u0442\u0432-\u0431\u043b\u043e\u043a\n|\u0443\u043c\u043b\u0430\u0441\u043a=\n|\u0438\u043c\u0435\u043d\u0430-\u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435=\n|\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435=\n|\u043f\u0440\u0438\u043b\u0430\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435=\n|\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435=\n|\u0433\u043b\u0430\u0433\u043e\u043b\u044b=\n|\u043d\u0430\u0440\u0435\u0447\u0438\u044f=\n|\u043f\u043e\u043b\u043d=\n|lang=enm\n}}\n\n=== \u042d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u044f ===\n\u0418\u0437 {{\u044d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u044f:|enm}}\n\n=== \u0424\u0440\u0430\u0437\u0435\u043e\u043b\u043e\u0433\u0438\u0437\u043c\u044b \u0438 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0435 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f ===\n* \n\n=== \u0411\u0438\u0431\u043b\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f ===\n* \n\n{{improve|enm|\u043c\u043e\u0440\u0444\u043e|\u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u044f|\u0441\u0438\u043d\u043e\u043d\u0438\u043c\u044b|\u0433\u0438\u043f\u0435\u0440\u043e\u043d\u0438\u043c\u044b|\u044d\u0442\u0438\u043c\u043e\u043b\u043e\u0433\u0438\u044f}}\n\n{{\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f|\u044f\u0437\u044b\u043a=enm|||}}\n{{\u0434\u043b\u0438\u043d\u0430 \u0441\u043b\u043e\u0432\u0430|4|lang=enm}}"}}}